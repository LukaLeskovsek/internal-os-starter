# =============================================================================
# Environment variables — the contract for this app.
#
# Keys live here (locally, in .env.local) and in your Vercel project settings —
# never in code, never in chat, never in the knowledge base.
#
# Setup: copy this file to ".env.local" and fill in only the services you use.
# =============================================================================

# --- Supabase: sign-in + database ---
NEXT_PUBLIC_SUPABASE_URL=           # Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # anon / publishable key — safe in the browser; RLS is the protection

# Only if you DON'T use the Supabase MCP (/nastavitev connects it): lets `npm run db:run`
# apply migrations. supabase.com → Account → Access Tokens. Account-scoped — revoke when done.
SUPABASE_ACCESS_TOKEN=

# Powers the Admin module's user management (add/role/disable/delete users).
# Supabase → Project Settings → API Keys → the **secret** key (`sb_secret_…`;
# the service_role replacement in the new key system). SERVER-ONLY and powerful:
# it BYPASSES Row Level Security. Never prefix with NEXT_PUBLIC, never put in code,
# never commit. Used only by lib/supabase/admin.ts behind owner checks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Initial owner bootstrap ---
# Used by `npm run seed:admin` after the migrations. It opens a one-time password
# link in the browser (`-- --print` prints it); public signups stay members with no grants.
ADMIN_EMAIL=
ADMIN_FULL_NAME=

# --- Resend: transactional email ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev    # workshop default test sender; own domain after the program

# --- Sentry: error tracking ---
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Intrix: optional reference integration (crm_demo module) ---
# Use only your own authorized account and credentials. No shared workshop key.
# Leave INTRIX_API_KEY empty to run the module in MOCK MODE (bundled demo data).
INTRIX_BASE_URL=                    # e.g. https://api.intrix.si/v1
INTRIX_API_KEY=

# --- Zoho CRM: optional, read-only customer list (work_orders module) ---
# Leave empty for demo customers. Access tokens expire; see modules/work_orders/lib/zoho.ts.
ZOHO_API_DOMAIN=                    # e.g. https://www.zohoapis.eu
ZOHO_ACCESS_TOKEN=

# --- AI: the system's LLM calls (lib/ai.ts, the ai_assist module) ---
# Your own OpenRouter API key (openrouter.ai → Keys), with a spending limit.
# This is separate from the Claude Desktop subscription and connector setup.
# SERVER-ONLY: never prefix with NEXT_PUBLIC, never put it in code.
# A deployed app may run without real AI when this key is blank.
# Local mode instead uses the verified subscription CLI.
OPENROUTER_API_KEY=
# Default model is Claude via OpenRouter. Verify the current slug at
# openrouter.ai/models. Switch to an OpenAI model id here to swap providers.
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
# The invoice_ocr module reads images + PDFs, so it needs a VISION + PDF capable model.
# Slugs move — verify the current one at openrouter.ai/models before API use.
# Local file calls use the same verified subscription route as text.
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.6
# Which engine answers generate() (lib/ai.ts):
#   openrouter   (explicit) — pay-as-you-go API via the key above; use on Vercel.
#   local-claude           — offload to your LOCAL Claude Code CLI (`claude -p`):
#                            your verified Claude SUBSCRIPTION answers. Plan limits
#                            and optional paid usage credits still apply. Only works
#                            on your own machine (claude installed
#                            + logged in) — great for building locally; keep it
#                            `openrouter` for the deployed app. It also reads
#                            images/PDFs (invoice_ocr) — no key needed locally.
# Local app calls remove environment provider credentials and verify installed
# subscription login before inference. Console OAuth is not a subscription.
AI_BACKEND=local-claude
# Company context for app AI belongs in reviewed module prompts.
# The local CLI runs in a private neutral folder, without personal tools.
# Max real OpenRouter calls per signed-in user per UTC day. Blank defaults to 20.
AI_DAILY_LIMIT_PER_USER=20

# --- Site ---
# Locally http://localhost:3000. On Vercel the live address (`npm run vercel:env -- --site-url …` sets it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Check what is filled in (never prints values): npm run env:check
